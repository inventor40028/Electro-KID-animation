      "location": "street",
      "framing": "medium",
      "camera": "pushIn",
      "focus": "hicks",
      "actors": [
        { "id": "hicks", "x": 0.5, "z": 0.5, "pose": "walk", "expression": "crazy" },
        { "id": "trainer1", "x": 0.74, "z": 0.42, "pose": "push", "facing": "left" },
        { "id": "trainer2", "x": 0.26, "z": 0.42, "pose": "push", "facing": "right" }
