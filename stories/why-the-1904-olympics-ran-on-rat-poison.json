    "carvajal": { "color": "#d8963a", "outfit": "vest", "hat": "straw", "hatColor": "#e4c872", "hair": "short", "hairColor": "#1d1410", "build": "skinny" },
    "trainer1": { "color": "#8a6a4a", "outfit": "shirt", "hat": "cap", "hatColor": "#5a4a3a", "mustache": true },
