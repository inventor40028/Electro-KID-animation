    {
      "say": "And Lorz? Six months later, he wins the Boston Marathon. Fair and square.",
      "location": "street",
      "framing": "full",
      "camera": "pushIn",
      "focus": "lorz",
      "actors": [
        { "id": "lorz", "x": 0.5, "z": 0.5, "pose": "armsUp", "expression": "grin", "holding": "trophy" },
        { "id": "crowd1", "x": 0.3, "z": 0.5, "pose": "armsUp", "expression": "laugh" },
        { "id": "crowd2", "x": 0.7, "z": 0.45, "pose": "wave", "expression": "grin" }
