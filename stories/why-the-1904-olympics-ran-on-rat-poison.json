      "say": "They finish it off with brandy.",
      "location": "plains",
      "framing": "close",
      "camera": "pushIn",
      "focus": "trainer2",
      "actors": [
        { "id": "trainer2", "x": 0.4, "z": 0.5, "pose": "holdUp", "expression": "wink", "holding": "bottle", "holdingLabel": "BRANDY" },
        { "id": "hicks", "x": 0.68, "z": 0.45, "pose": "cower", "expression": "sad", "facing": "left" }
      ],
      "beats": [{ "at": "brandy", "actor": "hicks", "expression": "crazy" }],
      "transition": "cut"
    },
    {
      "say": "He crosses the last stretch held in the air, feet still shuffling like they're running.",
      "location": "street",
      "framing": "full",
      "camera": "pushIn",
      "focus": "hicks",
      "actors": [
        { "id": "hicks", "x": 0.5, "z": 0.5, "pose": "run", "expression": "crazy" },
        { "id": "trainer1", "x": 0.74, "z": 0.44, "pose": "push", "facing": "left" },
        { "id": "trainer2", "x": 0.26, "z": 0.44, "pose": "push", "facing": "right" }
      ],
      "fx": ["stars"],
      "sfx": ["crowd"],
      "beats": [{ "at": "running", "actor": "hicks", "expression": "crazy", "zoom": 1.1 }]
