    {
      "say": "Then a stretcher. Eight pounds gone. Four doctors. Alive.",
      "bg": "hospital",
      "time": "day",
      "framing": "wide",
      "camera": "pushIn",
      "actors": [
        { "id": "hicks", "x": 0.42, "z": 0.38, "pose": "lie", "expression": "dead" },
        { "id": "doctor", "x": 0.74, "z": 0.42, "pose": "think", "expression": "worried", "facing": "left" }
      ],
      "sfx": ["heartbeat"],
      "beats": [{ "at": "Alive", "actor": "hicks", "expression": "surprised", "fx": "sparkle", "sfx": "chime", "zoom": 1.08 }],
      "transition": "cut"
    },
    {
      "say": "His time — three hours, twenty-eight — is still the slowest gold in marathon history.",
      "bg": "void",
      "framing": "wide",
      "camera": "static",
      "insert": { "type": "bigtext", "title": "3 HRS 28 MIN", "lines": ["slowest gold medal ever"], "color": "#f2c230" }
