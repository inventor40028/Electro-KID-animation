      "say": "'You rode eleven miles in a car!'",
      "location": "street",
      "framing": "close",
      "camera": "crashZoom",
      "focus": "official",
      "actors": [{ "id": "official", "x": 0.5, "z": 0.45, "pose": "point", "expression": "furious", "facing": "right" }],
      "quote": "official",
      "fx": ["rage"],
      "sfx": ["gasp"],
      "transition": "cut"
    },
    {
      "say": "'It was a joke!'",
      "location": "street",
      "framing": "medium",
      "camera": "pushIn",
      "focus": "lorz",
      "actors": [
        { "id": "lorz", "x": 0.66, "z": 0.48, "pose": "shrug", "expression": "smug" },
        { "id": "official", "x": 0.35, "z": 0.44, "pose": "crossed", "expression": "furious", "facing": "right" }
