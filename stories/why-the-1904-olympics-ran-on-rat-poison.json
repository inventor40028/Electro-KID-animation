      "props": [{ "type": "car", "x": 0.1, "z": 0.06, "color": "#8a8a92", "rotate": -4 }],
      "sfx": ["engine"],
      "transition": "whip"
    },
    {
      "say": "The crowd goes wild. The President's daughter crowns him.",
      "location": "street",
      "framing": "full",
      "camera": "pushIn",
      "focus": "lorz",
      "actors": [
        { "id": "lorz", "x": 0.5, "z": 0.5, "pose": "armsUp", "expression": "laugh" },
        { "id": "alice", "x": 0.78, "z": 0.44, "pose": "reach", "expression": "happy", "facing": "left" },
        { "id": "crowd1", "x": 0.26, "z": 0.55, "pose": "armsUp", "expression": "laugh" }
      ],
      "props": [
        { "type": "sign", "x": 0.15, "z": 0.35, "label": "FINISH", "scale": 1 },
        { "type": "flag", "x": 0.9, "z": 0.3, "color": "#d8342c" },
        { "type": "flag", "x": 0.06, "z": 0.3, "color": "#2a5ad8" }
