  "shots": [
    {
      "say": "The first man across the line of the 1904 Olympic marathon had spent eleven miles of it in a car.",
      "location": "street",
      "framing": "full",
      "camera": "pushIn",
      "focus": "lorz",
      "actors": [
        { "id": "lorz", "x": 0.45, "z": 0.5, "pose": "walk", "expression": "grin", "moveTo": 0.55 },
        { "id": "official", "x": 0.74, "z": 0.42, "pose": "crossed", "expression": "suspicious", "facing": "left" }
      ],
      "props": [{ "type": "car", "x": 0.14, "z": 0.04, "color": "#7a8a9a" }],
      "fx": ["dust"],
      "sfx": ["engine"],
      "beats": [{ "at": "eleven", "actor": "lorz", "expression": "crazy", "zoom": 1.08 }]
    },
    {
      "say": "The official winner? He ran the last ten miles on rat poison.",
      "bg": "void",
      "framing": "wide",
      "camera": "static",
      "insert": { "type": "bigtext", "title": "RAT POISON", "lines": ["for the gold medal"], "color": "#ff5a4a" },
      "transition": "cut"
    },
    {
      "say": "It's St. Louis. It's 90 degrees. Thirty-two runners. One water stop.",
      "location": "plains",
      "framing": "wide",
      "camera": "pullOut",
      "focus": "hicks",
      "actors": [
        { "id": "hicks", "x": 0.55, "z": 0.55, "pose": "run", "expression": "determined" },
        { "id": "carvajal", "x": 0.42, "z": 0.52, "pose": "run" },
        { "id": "lorz", "x": 0.7, "z": 0.48, "pose": "run" }
      ],
      "props": [{ "type": "sign", "x": 0.76, "z": 0.4, "label": "WATER", "scale": 0.9 }],
      "tint": "#e0944a",
      "fx": ["dust"],
      "transition": "whip"
    },
    {
      "say": "Meanwhile, a Cuban postman shows up — broke, starving — steals two peaches,",
      "location": "plains",
      "framing": "full",
      "camera": "panRight",
      "focus": "carvajal",
      "actors": [
        { "id": "carvajal", "x": 0.35, "z": 0.5, "pose": "walk", "expression": "happy", "holding": "food" },
        { "id": "crowd1", "x": 0.72, "z": 0.42, "pose": "hold", "expression": "suspicious", "facing": "left", "holding": "food" }
      ],
      "props": [{ "type": "bush", "x": 0.85, "z": 0.3, "scale": 1.1 }],
      "beats": [{ "at": "steals", "actor": "carvajal", "pose": "run", "expression": "crazy", "sfx": "whoosh" }],
      "transition": "iris"
    },
    {
      "say": "eats rotten apples, and takes a dirt nap.",
      "location": "plains",
      "framing": "medium",
      "camera": "drift",
      "focus": "carvajal",
      "actors": [{ "id": "carvajal", "x": 0.45, "z": 0.5, "pose": "cower", "expression": "crazy" }],
      "props": [{ "type": "bush", "x": 0.82, "z": 0.3, "scale": 1.2 }],
      "beats": [
        { "at": "apples", "expression": "worried", "fx": "sweat" },
        { "at": "nap", "pose": "lie", "expression": "sleepy", "fx": "zzz", "sfx": "boing" }
      ]
    },
    {
      "say": "Fred Lorz cramps at mile nine. A car pulls up: 'Hop in, champ.'",
      "location": "plains",
      "framing": "full",
      "camera": "drift",
      "focus": "lorz",
      "actors": [
        { "id": "lorz", "x": 0.35, "z": 0.5, "pose": "cower", "expression": "scared" },
        { "id": "driver", "x": 0.72, "z": 0.48, "pose": "talk", "expression": "grin", "facing": "left" }
      ],
      "props": [{ "type": "car", "x": 0.93, "z": 0.22, "color": "#c9a23a" }],
      "quote": "driver",
      "sfx": ["horn"],
      "beats": [{ "at": "champ", "actor": "driver", "expression": "wink" }]
    },
    {
      "say": "The car dies at mile nineteen, so Lorz jogs across the line first.",
      "location": "street",
      "framing": "full",
      "camera": "drift",
      "focus": "lorz",
      "actors": [
        { "id": "lorz", "x": 0.62, "z": 0.5, "pose": "walk", "expression": "grin", "moveTo": 0.52 },
        { "id": "crowd2", "x": 0.8, "z": 0.4, "pose": "crossed", "expression": "suspicious", "facing": "left" }
