    {
      "say": "A little dose revives you, like coffee.",
      "location": "plains",
      "framing": "medium",
      "camera": "pushIn",
      "focus": "trainer1",
      "actors": [
        { "id": "hicks", "x": 0.55, "z": 0.5, "pose": "hips", "expression": "crazy", "facing": "left" },
        { "id": "trainer1", "x": 0.3, "z": 0.45, "pose": "holdUp", "expression": "grin", "holding": "mug", "facing": "right" }
      ],
      "fx": ["sparkle"],
      "sfx": ["boing"],
      "transition": "cut"
    },
    {
      "say": "A big dose stops your heart. His trainers walk that line for ten miles.",
      "bg": "void",
      "framing": "wide",
      "camera": "static",
      "insert": { "type": "bigtext", "title": "DOSE MATH", "lines": ["a sprinkle = coffee", "a handful = dead"], "color": "#f2c230" }
    },
