      "say": "You see, in 1904, medicine's cure for exhaustion was poison.",
      "location": "street",
      "framing": "close",
      "camera": "pushIn",
      "focus": "trainer2",
      "actors": [
        { "id": "trainer2", "x": 0.45, "z": 0.5, "pose": "talk", "expression": "determined" },
        { "id": "hicks", "x": 0.8, "z": 0.4, "pose": "cower", "expression": "worried", "facing": "left" }
      ],
      "quote": "trainer2",
      "transition": "cut"
    },
    {
      "say": "Hicks' trainers feed him strychnine — rat poison — beaten into egg whites.",
      "location": "plains",
      "framing": "medium",
      "camera": "pushIn",
      "focus": "trainer1",
      "actors": [
        { "id": "trainer1", "x": 0.38, "z": 0.48, "pose": "holdUp", "expression": "determined" },
        { "id": "hicks", "x": 0.62, "z": 0.45, "pose": "cower", "expression": "suspicious", "facing": "left" }
      ],
      "props": [
        { "type": "rat", "x": 0.24, "z": 0.6, "scale": 1.5, "color": "#7a7a86" },
        { "type": "flask", "x": 0.5, "z": 0.15, "y": 200, "color": "#f4f0d8" }
